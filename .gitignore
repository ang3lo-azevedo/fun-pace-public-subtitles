__pycache__/
*.pyc
# source videos can be huge; keep reference ASS files in input/styles tracked
input/episodes/*.mkv

# uncut source episodes, used by the retiming approach to pull their own
# embedded subtitles and to align a Fun Pace cut against. Too large for a
# public repo, and the embedded subtitles are someone else's translation
# work rather than this project's own output.
input/source-episodes/

# generated outputs
output/episodes/

# `run` symlinks the generated ASS next to the source video; this tracks
# generated output, not reference style files (which live in input/styles/).
input/episodes/*\[Subs Missing\]*.ass
input/episodes/*\[AI Subs\]*.ass
